PORT=3001
ERP_FISH_MODE=production
# For self-hosted local execution, set ERP_FISH_MODE=local and ERP_CREDENTIALS_KEY.
# Use the Docker quickstart for Chromium + its display. NODE_ENV stays standard.
# LOCAL_BROWSER_DATA_DIR=.browser-data
# LOCAL_BROWSER_HEADLESS=false
CORS_ORIGIN=http://localhost:3000
DB_PATH=erp-fish.db
# Legacy orchestrator fixture setting. The chat agent API always uses the
# connected account's ERP with the selected browser provider; no canned write results.
DEMO_AGENT=false
# Auth (plan-mode). JWT_SECRET has no default: the api refuses to boot without
# it. Generate one with `openssl rand -base64 48`. Never commit the real value.
# JWT_SECRET=
# Optional stable encryption key for local ERP logins (base64, 32 random bytes).
# Generate once; keep it with the database backup. Changing it requires users
# to save their ERP credentials again. It is never sent to TinyFish or the LLM.
# ERP_CREDENTIALS_KEY=
# JWT_TTL_SECONDS=604800
# Live config (keyed phase). ERP_BASE_URL is the frozen tunnel URL.
# ERP_BASE_URL=
# TUNNEL_PROFILE_ID=
# TINYFISH_API_KEY=
# Remote logins must already exist in TinyFish Vault (1Password or Bitwarden).
# Server-controlled assignment prevents users accessing another account's logins.
# Assign only an existing, approved ERP Fish user ID and exact normalized ERP URL.
# Emails are not verified at signup, so they must never grant Vault access.
# Never put passwords here. User IDs and credential item IDs are references only.
# TINYFISH_VAULT_BINDINGS='[{"user_id":"00000000-0000-4000-8000-000000000001","erp_url":"https://erp.example.com","credential_item_id":"cred:connection:vault:item"}]'
# Pluggable OpenAI-compatible LLM endpoint for PDF/text invoice parse and
# plan-mode chat. JSON paste works without them; PDF/text parse returns 503
# naming the missing var until these are set. Tested default: OpenCode Go
# (OpenAI-compatible, needs x-opencode-session which the api sends per
# thread, plus a User-Agent the api sets itself).
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-v4-flash
# Never commit real keys.
# Optional desktop voice dictation (Groq whisper-large-v3).
# GROQ_API_KEY=
# Legacy adapter fixture only; generic chat-agent execution ignores site hints.
# MOCK_ERP_URL=https://demo-erp.fukumean.me
