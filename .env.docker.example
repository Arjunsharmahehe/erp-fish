# Copy using scripts/setup-local.ps1, which generates the two persistent secrets.
ERP_FISH_MODE=local
JWT_SECRET=GENERATE_ONCE
ERP_CREDENTIALS_KEY=GENERATE_ONCE
WEB_PORT=3002
API_PORT=3001
WEB_ORIGIN=http://localhost:3002
API_PUBLIC_URL=http://localhost:3001
# Optional defaults. Individual accounts can instead configure their model in Settings.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional voice dictation; not required for typed tasks.
GROQ_API_KEY=
# Optional in local mode. Required for remote agent sessions in production.
TINYFISH_API_KEY=
TINYFISH_VAULT_BINDINGS=[]
