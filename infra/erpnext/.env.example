# Pinned ERPNext image for the erp-fish demo (verified on Docker Hub 2026-10-24:
# frappe/erpnext v16.52.1 exists for linux/amd64 + linux/arm64).
ERPNEXT_VERSION=v16.52.1

# Fresh MariaDB for the demo site. Change on first use.
DB_ROOT_PASSWORD=change-me-mariadb-root
DB_NAME=erpnext-demo

# Site + admin. The site name becomes the local URL path segment.
ERPNEXT_SITE=erp.demo.local
ADMIN_PASSWORD=change-me-admin

# Published HTTP port for local access (tunnel points here).
LOCAL_HTTP_PORT=8080
